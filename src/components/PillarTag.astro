---
import { PILLARS, type PillarKey } from '../lib/pillars';

interface Props {
  pillar: number;
}

const { pillar } = Astro.props;
const p = PILLARS[pillar as PillarKey];
---

<span class="pillar-tag" style={`--tag-color: ${p.color}`}>
  {p.name}
</span>

<style>
  .pillar-tag {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.28em var(--space-2);
    border-radius: calc(var(--radius) / 2);
    border: 1.5px solid var(--tag-color);
    color: var(--tag-color);
    background: transparent;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
</style>
