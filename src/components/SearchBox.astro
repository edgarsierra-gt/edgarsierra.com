---
// Pagefind search UI.
// Only functional after `npm run build` (pagefind indexes the dist/ folder).
// In dev mode, shows a friendly fallback message.
---

<div class="search-wrapper">
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="pagefind-search" aria-label="Buscar en el sitio"></div>
</div>

<script is:inline>
  (function () {
    var script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = function () {
      new PagefindUI({
        element: '#pagefind-search',
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: 'Buscar artículos...',
          zero_results: 'Sin resultados para "[QUERY]".',
        },
      });
    };
    script.onerror = function () {
      var el = document.getElementById('pagefind-search');
      if (el) {
        el.innerHTML =
          '<p style="font-family:var(--font-ui);font-size:var(--text-sm);color:var(--ink-muted);padding:var(--space-2) 0">' +
          'Búsqueda disponible tras <code>npm run build</code>.' +
          '</p>';
      }
    };
    document.head.appendChild(script);
  })();
</script>

<style>
  .search-wrapper {
    margin-bottom: var(--space-4);
  }

  /* Override Pagefind UI colors to match design tokens */
  :global(#pagefind-search) {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--code-bg);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-font: var(--font-ui);
  }
</style>
