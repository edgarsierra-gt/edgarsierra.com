---
import { formatGeneratedAt } from '../../lib/worldcup/format';
import type { ModelMetadata as Metadata } from '../../lib/worldcup/types';

interface Props {
  metadata: Metadata;
}

const { metadata } = Astro.props;
---

<section class="metadata" data-reveal>
  <div class="section-header">
    <p class="eyebrow">Estado del modelo</p>
    <h2>Contrato y límites actuales</h2>
  </div>
  <dl>
    <div>
      <dt>Versión</dt>
      <dd>{metadata.model_version}</dd>
    </div>
    <div>
      <dt>Modo</dt>
      <dd>{metadata.model_mode}</dd>
    </div>
    <div>
      <dt>Actualizado</dt>
      <dd>{formatGeneratedAt(metadata.generated_at)}</dd>
    </div>
  </dl>
  {metadata.limitations.length > 0 && (
    <div class="limitations">
      <h3>Limitaciones declaradas</h3>
      <ul>
        {metadata.limitations.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  )}
</section>

<style>
  .metadata {
    display: grid;
    gap: var(--space-3);
  }

  .eyebrow {
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    color: var(--wc-text);
    font-size: var(--text-xl);
    margin-top: 0.25rem;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  dl div,
  .limitations {
    padding: var(--space-3);
    border: 1px solid var(--wc-border);
    border-radius: 20px;
    background: var(--wc-bg-2);
    box-shadow: 0 4px 12px rgba(24, 24, 27, 0.02);
  }

  dt {
    color: var(--wc-muted);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
  }

  dd {
    color: var(--wc-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  h3 {
    color: var(--wc-text);
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  ul {
    padding-left: var(--space-3);
    color: var(--wc-soft);
  }

  li + li {
    margin-top: var(--space-1);
  }

  @media (max-width: 720px) {
    dl {
      grid-template-columns: 1fr;
    }
  }
</style>
