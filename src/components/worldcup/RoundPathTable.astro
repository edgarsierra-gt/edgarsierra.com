---
import TeamBadge from './TeamBadge.astro';
import { formatBracketMode, formatPercent } from '../../lib/worldcup/format';
import type { RoundProbabilities } from '../../lib/worldcup/types';

interface Props {
  probabilities: RoundProbabilities;
  limit?: number;
  showHeader?: boolean;
}

const { probabilities, limit = 12, showHeader = true } = Astro.props;
const teams = probabilities.teams
  .filter((team) => team.prob_round_of_32 > 0)
  .sort((a, b) => b.prob_round_of_16 - a.prob_round_of_16 || b.prob_champion - a.prob_champion)
  .slice(0, limit);
const heat = (value: number) => Math.max(0.08, Math.min(0.75, value));
---

<section class="round-section" data-reveal>
  {showHeader && (
    <div class="section-header">
      <p class="eyebrow">Camino</p>
      <h2>Probabilidades por ronda</h2>
      <p>
        Camino estimado bajo {formatBracketMode(probabilities.bracket_mode).toLowerCase()}. Sirve para comparar escenarios, no para prometer resultados.
      </p>
    </div>
  )}

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Selección</th>
          <th>R32</th>
          <th>R16</th>
          <th>Cuartos</th>
          <th>Semis</th>
          <th>Final</th>
          <th>Campeón</th>
        </tr>
      </thead>
      <tbody>
        {teams.map((team) => (
          <tr>
            <th scope="row"><TeamBadge team_id={team.team_id} name={team.name} /></th>
            <td style={`--heat: ${heat(team.prob_round_of_32)}`}>{formatPercent(team.prob_round_of_32, 0)}</td>
            <td style={`--heat: ${heat(team.prob_round_of_16)}`}>{formatPercent(team.prob_round_of_16, 0)}</td>
            <td style={`--heat: ${heat(team.prob_quarterfinal)}`}>{formatPercent(team.prob_quarterfinal, 0)}</td>
            <td style={`--heat: ${heat(team.prob_semifinal)}`}>{formatPercent(team.prob_semifinal, 0)}</td>
            <td style={`--heat: ${heat(team.prob_final)}`}>{formatPercent(team.prob_final, 1)}</td>
            <td style={`--heat: ${heat(team.prob_champion)}`}>{formatPercent(team.prob_champion, 1)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .round-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: 820px;
  }

  .eyebrow {
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  h2 {
    color: var(--wc-text);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--wc-soft);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--wc-border);
    border-radius: 24px;
    background: var(--wc-bg-2);
    box-shadow: 0 8px 30px rgba(24, 24, 27, 0.04);
  }

  table {
    width: 100%;
    min-width: 780px;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--wc-border);
    color: var(--wc-soft);
    text-align: right;
    white-space: nowrap;
  }

  td {
    background: rgba(86, 180, 233, calc(var(--heat) * 0.3));
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  thead th {
    color: var(--wc-text);
    font-family: var(--font-ui);
    background: var(--wc-bg-3);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
