---
import { formatBracketMode, formatPercent } from '../../lib/worldcup/format';
import type { RoundProbabilities } from '../../lib/worldcup/types';

interface Props {
  probabilities: RoundProbabilities;
  limit?: number;
}

const { probabilities, limit = 12 } = Astro.props;
const teams = probabilities.teams
  .filter((team) => team.prob_round_of_32 > 0)
  .sort((a, b) => b.prob_round_of_16 - a.prob_round_of_16 || b.prob_champion - a.prob_champion)
  .slice(0, limit);
---

<section class="round-section" data-reveal>
  <div class="section-header">
    <p class="eyebrow">Camino</p>
    <h2>Probabilidades por ronda</h2>
    <p>
      Camino estimado por ronda bajo {formatBracketMode(probabilities.bracket_mode).toLowerCase()}. Sirve para comparar escenarios, no para prometer resultados.
    </p>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Equipo</th>
          <th>R32</th>
          <th>R16</th>
          <th>Cuartos</th>
          <th>Semis</th>
          <th>Final</th>
          <th>Campeon</th>
        </tr>
      </thead>
      <tbody>
        {teams.map((team) => (
          <tr>
            <th scope="row">{team.name}</th>
            <td>{formatPercent(team.prob_round_of_32, 0)}</td>
            <td>{formatPercent(team.prob_round_of_16, 0)}</td>
            <td>{formatPercent(team.prob_quarterfinal, 0)}</td>
            <td>{formatPercent(team.prob_semifinal, 0)}</td>
            <td>{formatPercent(team.prob_final, 1)}</td>
            <td>{formatPercent(team.prob_champion, 1)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .round-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: var(--reading);
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--accent);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  h2 {
    font-size: var(--text-2xl);
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--ink-muted);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--border);
    text-align: right;
    white-space: nowrap;
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  thead th {
    font-family: var(--font-ui);
    color: var(--ink);
    background: var(--code-bg);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
