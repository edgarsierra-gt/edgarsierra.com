---
import TeamBadge from './TeamBadge.astro';
import { getTeamDisplay } from '../../lib/worldcup/teams';
import { formatNumber } from '../../lib/worldcup/format';
import type { TeamMatchStats } from '../../lib/worldcup/types';

interface Props {
  stats: TeamMatchStats;
  limit?: number;
  showHeader?: boolean;
}

const { stats, limit, showHeader = true } = Astro.props;
const teams = typeof limit === 'number' ? stats.teams.slice(0, limit) : stats.teams;

const DIACRITICS = new RegExp(`[${String.fromCharCode(0x300)}-${String.fromCharCode(0x36f)}]`, 'g');

function normalize(value: string): string {
  return value.normalize('NFD').replace(DIACRITICS, '').toLowerCase();
}

function formatGoalDifference(value: number): string {
  return value > 0 ? `+${value}` : String(value);
}
---

<section class="stats-table-section" data-reveal>
  {showHeader && (
    <div class="section-header">
      <p class="eyebrow">Datos reales del torneo</p>
      <h2>Estadísticas por selección</h2>
      <p>
        Resultados, posesión y goles esperados (xG) de los {stats.matches_analyzed} partidos jugados del Mundial 2026, no es una simulación. Remates, córners y tarjetas de cada selección están en su página de detalle.
      </p>
    </div>
  )}

  <input
    type="search"
    id="team-search"
    class="team-search"
    placeholder="Buscar selección por nombre o código..."
    aria-label="Buscar selección"
  />

  <div class="table-wrap">
    <table id="team-stats-table">
      <thead>
        <tr>
          <th>Selección</th>
          <th>PJ</th>
          <th>Pts</th>
          <th>GF</th>
          <th>GC</th>
          <th>DG</th>
          <th>Posesión %</th>
          <th>xG</th>
          <th>Dif. xG</th>
        </tr>
      </thead>
      <tbody>
        {teams.map((team) => {
          const display = getTeamDisplay({ id: team.team_id });
          const searchKey = normalize(`${display.name} ${display.code}`);
          return (
            <tr data-search={searchKey}>
              <th scope="row">
                <a href={`/mundial-2026/estadisticas/${team.team_id.toLowerCase()}`}>
                  <TeamBadge team_id={team.team_id} />
                </a>
              </th>
              <td>{team.played}</td>
              <td class="points-cell">{team.points}</td>
              <td>{team.goals_for}</td>
              <td>{team.goals_against}</td>
              <td>{formatGoalDifference(team.goal_difference)}</td>
              <td>{formatNumber(team.possession_avg_pct, 1)}%</td>
              <td>{formatNumber(team.xg_for, 2)}</td>
              <td>{formatGoalDifference(team.xg_difference)}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="no-results" id="team-search-empty" hidden>Ninguna selección coincide con la búsqueda.</p>
  </div>
</section>

<script>
  const searchInput = document.getElementById('team-search') as HTMLInputElement | null;
  const table = document.getElementById('team-stats-table');
  const emptyState = document.getElementById('team-search-empty');

  const diacritics = new RegExp(`[${String.fromCharCode(0x300)}-${String.fromCharCode(0x36f)}]`, 'g');

  function normalizeQuery(value: string): string {
    return value.normalize('NFD').replace(diacritics, '').toLowerCase();
  }

  searchInput?.addEventListener('input', () => {
    const query = normalizeQuery(searchInput.value.trim());
    const rows = table?.querySelectorAll<HTMLTableRowElement>('tbody tr') ?? [];
    let visibleCount = 0;
    rows.forEach((row) => {
      const matches = query === '' || (row.dataset.search ?? '').includes(query);
      row.hidden = !matches;
      if (matches) visibleCount += 1;
    });
    if (emptyState) emptyState.hidden = visibleCount > 0;
  });
</script>

<style>
  .stats-table-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: 820px;
  }

  .eyebrow {
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  h2 {
    color: var(--wc-text);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--wc-soft);
  }

  .team-search {
    width: 100%;
    max-width: 360px;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--wc-border-strong);
    border-radius: 999px;
    background: var(--wc-bg-2);
    color: var(--wc-text);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .team-search::placeholder {
    color: var(--wc-muted);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--wc-border);
    border-radius: 24px;
    background: var(--wc-bg-2);
    box-shadow: 0 8px 30px rgba(24, 24, 27, 0.04);
  }

  table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--wc-border);
    color: var(--wc-soft);
    text-align: right;
    white-space: nowrap;
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  thead th {
    color: var(--wc-text);
    font-family: var(--font-ui);
    background: var(--wc-bg-3);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .points-cell {
    color: var(--wc-text);
    font-weight: 700;
  }

  .no-results {
    padding: var(--space-4);
    color: var(--wc-soft);
    text-align: center;
  }
</style>
