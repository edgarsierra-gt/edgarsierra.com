---
import { formatPercent } from '../../lib/worldcup/format';

interface Props {
  teamAWin: number;
  draw: number;
  teamBWin: number;
  teamAName: string;
  teamBName: string;
}

const { teamAWin, draw, teamBWin, teamAName, teamBName } = Astro.props;
const segments = [
  { label: teamAName, value: teamAWin, className: 'team-a' },
  { label: 'Empate', value: draw, className: 'draw' },
  { label: teamBName, value: teamBWin, className: 'team-b' },
];
---

<div class="probability-block" aria-label="Probabilidades 1X2">
  <div class="probability-bar" aria-hidden="true">
    {segments.map((segment) => (
      <span class:list={['segment', segment.className]} style={`width: ${segment.value * 100}%`}></span>
    ))}
  </div>
  <dl class="probability-list">
    {segments.map((segment) => (
      <div>
        <dt>{segment.label}</dt>
        <dd>{formatPercent(segment.value)}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .probability-block {
    display: grid;
    gap: var(--space-2);
  }

  .probability-bar {
    display: flex;
    width: 100%;
    height: 0.65rem;
    overflow: hidden;
    border-radius: calc(var(--radius) / 2);
    background: var(--code-bg);
    border: 1px solid var(--border);
  }

  .segment {
    display: block;
    min-width: 2px;
  }

  .team-a { background: var(--accent); }
  .draw { background: var(--c-orange); }
  .team-b { background: var(--accent-2); }

  .probability-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-1);
  }

  .probability-list div {
    min-width: 0;
  }

  dt {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  dd {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--ink);
  }
</style>

