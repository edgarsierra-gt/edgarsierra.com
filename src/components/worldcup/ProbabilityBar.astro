---
import { formatPercent } from '../../lib/worldcup/format';

interface Props {
  teamAWin: number;
  draw: number;
  teamBWin: number;
  teamAName: string;
  teamBName: string;
}

const { teamAWin, draw, teamBWin, teamAName, teamBName } = Astro.props;
const segments = [
  { label: teamAName, short: 'A', value: teamAWin, className: 'team-a' },
  { label: 'Empate', short: 'X', value: draw, className: 'draw' },
  { label: teamBName, short: 'B', value: teamBWin, className: 'team-b' },
];
---

<div class="probability-block" aria-label="Probabilidades 1X2">
  <div class="probability-bar" aria-hidden="true">
    {segments.map((segment) => (
      <span class:list={['segment', segment.className]} style={`width: ${Math.max(segment.value * 100, 2)}%`}>
        <span>{formatPercent(segment.value)}</span>
      </span>
    ))}
  </div>
  <dl class="probability-list">
    {segments.map((segment) => (
      <div>
        <dt>
          <span class:list={['dot', segment.className]}></span>
          {segment.short} · {segment.label}
        </dt>
        <dd>{formatPercent(segment.value)}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .probability-block {
    display: grid;
    gap: var(--space-2);
  }

  .probability-bar {
    display: flex;
    width: 100%;
    min-height: 1.05rem;
    overflow: hidden;
    border: 1px solid var(--wc-border);
    border-radius: 999px;
    background: var(--wc-bg-3);
  }

  .segment {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .team-a {
    background: linear-gradient(90deg, var(--wc-blue), var(--wc-cyan));
  }

  .draw {
    background: linear-gradient(90deg, var(--wc-yellow), rgba(113, 113, 122, 0.4));
  }

  .team-b {
    background: linear-gradient(90deg, var(--wc-green), var(--wc-orange));
  }

  .probability-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .probability-list div {
    min-width: 0;
    padding: 0.65rem;
    border: 1px solid var(--wc-border);
    border-radius: 16px;
    background: var(--wc-bg-3);
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    color: var(--wc-muted);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  dd {
    margin-top: 0.2rem;
    color: var(--wc-text);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
  }

  .dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 999px;
    flex: 0 0 auto;
  }

  .dot.team-a { background: var(--wc-cyan); }
  .dot.draw { background: var(--wc-yellow); }
  .dot.team-b { background: var(--wc-green); }

  @media (max-width: 520px) {
    .probability-list {
      grid-template-columns: 1fr;
    }
  }
</style>
