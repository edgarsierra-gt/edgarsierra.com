---
import TeamBadge from './TeamBadge.astro';
import { formatPercent } from '../../lib/worldcup/format';
import type { GroupProbabilities } from '../../lib/worldcup/types';

interface Props {
  probabilities: GroupProbabilities;
  limitGroups?: number;
  showHeader?: boolean;
}

const { probabilities, limitGroups, showHeader = true } = Astro.props;
const groups = typeof limitGroups === 'number' ? probabilities.groups.slice(0, limitGroups) : probabilities.groups;
---

<section class="group-section" data-reveal>
  {showHeader && (
    <div class="section-header">
      <p class="eyebrow">Simulación</p>
      <h2>Probabilidad de clasificación por grupo</h2>
      <p>
        El modelo combina resultados reales con simulación de partidos pendientes. Las probabilidades cambian después de cada actualización y deben leerse como escenarios.
      </p>
    </div>
  )}

  <div class="groups-grid">
    {groups.map((group) => (
      <article class="group-block" id={`grupo-${group.group.toLowerCase()}`}>
        <div class="group-title">
          <h3>Grupo {group.group}</h3>
          <span>{group.teams.length} selecciones</span>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Selección</th>
                <th>Pts</th>
                <th>Avanza</th>
                <th>1º</th>
                <th>2º</th>
                <th>3º clas.</th>
                <th>Elim.</th>
              </tr>
            </thead>
            <tbody>
              {group.teams.map((team) => (
                <tr>
                  <th scope="row"><TeamBadge team_id={team.team_id} name={team.name} /></th>
                  <td>{team.points}</td>
                  <td class="advance-cell">
                    <span>{formatPercent(team.prob_advance, 0)}</span>
                    <i aria-hidden="true"><b style={`width: ${team.prob_advance * 100}%`}></b></i>
                  </td>
                  <td>{formatPercent(team.prob_group_winner, 0)}</td>
                  <td>{formatPercent(team.prob_group_runner_up, 0)}</td>
                  <td>{formatPercent(team.prob_qualified_as_third, 0)}</td>
                  <td>{formatPercent(team.prob_eliminated_group, 0)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .group-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: 820px;
  }

  .eyebrow {
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  h2 {
    color: var(--wc-text);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--wc-soft);
  }

  .groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: var(--space-3);
  }

  .group-block {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .group-title {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: end;
  }

  h3 {
    color: var(--wc-text);
    font-size: var(--text-xl);
  }

  .group-title span {
    color: var(--wc-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--wc-border);
    border-radius: 22px;
    background: var(--wc-bg-2);
    box-shadow: 0 8px 30px rgba(24, 24, 27, 0.04);
  }

  table {
    width: 100%;
    min-width: 650px;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: 0.72rem;
    border-bottom: 1px solid var(--wc-border);
    color: var(--wc-soft);
    text-align: right;
    white-space: nowrap;
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  thead th {
    color: var(--wc-text);
    font-family: var(--font-ui);
    background: var(--wc-bg-3);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .advance-cell {
    min-width: 140px;
  }

  .advance-cell span {
    display: inline-block;
    min-width: 3rem;
    color: var(--wc-text);
  }

  .advance-cell i {
    display: inline-flex;
    width: 62px;
    height: 0.4rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--wc-bg-3);
    vertical-align: middle;
  }

  .advance-cell b {
    display: block;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--wc-blue), var(--wc-green));
  }
</style>
