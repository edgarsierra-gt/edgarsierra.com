---
import TeamBadge from './TeamBadge.astro';
import { formatPercent } from '../../lib/worldcup/format';
import type { GroupProbabilities } from '../../lib/worldcup/types';

interface Props {
  probabilities: GroupProbabilities;
  limitGroups?: number;
  showHeader?: boolean;
}

const { probabilities, limitGroups, showHeader = true } = Astro.props;
const groups = typeof limitGroups === 'number' ? probabilities.groups.slice(0, limitGroups) : probabilities.groups;
---

<section class="group-section" data-reveal>
  {showHeader && (
    <div class="section-header">
      <p class="eyebrow">Simulación</p>
      <h2>Probabilidad de clasificación por grupo</h2>
      <p>
        El modelo combina resultados reales con simulación de partidos pendientes. Las probabilidades cambian después de cada actualización y deben leerse como escenarios.
      </p>
    </div>
  )}

  <div class="groups-grid">
    {groups.map((group) => (
      <article class="group-block" id={`grupo-${group.group.toLowerCase()}`}>
        <div class="group-title">
          <h3>Grupo {group.group}</h3>
          <span>{group.teams.length} selecciones</span>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Selección</th>
                <th>Pts</th>
                <th class="advance-header">Avanza</th>
              </tr>
            </thead>
            <tbody>
              {group.teams.map((team) => (
                <tr>
                  <th scope="row">
                    <div class="team-info">
                      <TeamBadge team_id={team.team_id} name={team.name} />
                      <div class="prob-breakdown">
                        <span>1º: {formatPercent(team.prob_group_winner, 0)}</span>
                        <span>2º: {formatPercent(team.prob_group_runner_up, 0)}</span>
                        <span>3º: {formatPercent(team.prob_qualified_as_third, 0)}</span>
                        <span>Elim: {formatPercent(team.prob_eliminated_group, 0)}</span>
                      </div>
                    </div>
                  </th>
                  <td class="points-cell">{team.points}</td>
                  <td class="advance-cell">
                    <span>{formatPercent(team.prob_advance, 0)}</span>
                    <i aria-hidden="true"><b style={`width: ${team.prob_advance * 100}%`}></b></i>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .group-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: 820px;
  }

  .eyebrow {
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  h2 {
    color: var(--wc-text);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--wc-soft);
  }

  .groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: var(--space-3);
  }

  .group-block {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .group-title {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: end;
  }

  h3 {
    color: var(--wc-text);
    font-size: var(--text-xl);
  }

  .group-title span {
    color: var(--wc-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .table-wrap {
    border: 1px solid var(--wc-border);
    border-radius: 22px;
    background: var(--wc-bg-2);
    box-shadow: 0 8px 30px rgba(24, 24, 27, 0.04);
    overflow-x: auto;
    position: relative;
  }

  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    table-layout: fixed;
  }

  th,
  td {
    padding: 0.72rem;
    border-bottom: 1px solid var(--wc-border);
    color: var(--wc-soft);
    text-align: right;
    white-space: nowrap;
    vertical-align: middle;
  }

  th:first-child,
  td:first-child {
    text-align: left;
    white-space: normal;
    overflow: hidden;
    width: auto;
  }

  th:nth-child(2),
  td:nth-child(2) {
    width: 50px;
    text-align: right;
  }

  th:last-child,
  td:last-child {
    width: 125px;
    text-align: right;
    padding-left: 0.4rem;
    padding-right: 0.72rem;
  }

  thead th {
    color: var(--wc-text);
    font-family: var(--font-ui);
    background: var(--wc-bg-3);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .team-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-start;
  }

  .prob-breakdown {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--wc-muted);
    font-weight: normal;
  }

  .prob-breakdown span {
    white-space: nowrap;
  }

  .points-cell {
    font-weight: 700;
    color: var(--wc-text);
  }

  .advance-header {
    text-align: right;
  }

  .advance-cell {
    width: 125px;
  }

  .advance-cell span {
    display: inline-block;
    min-width: 2.8rem;
    color: var(--wc-text);
    font-weight: 700;
  }

  .advance-cell i {
    display: inline-flex;
    width: 58px;
    height: 0.4rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--wc-bg-3);
    vertical-align: middle;
  }

  .advance-cell b {
    display: block;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--wc-blue), var(--wc-green));
  }
</style>
