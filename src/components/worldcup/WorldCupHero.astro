---
import ProbabilityBar from './ProbabilityBar.astro';
import TeamBadge from './TeamBadge.astro';
import { formatNumber, formatPercent } from '../../lib/worldcup/format';
import type { MatchPrediction } from '../../lib/worldcup/types';

interface Props {
  featuredMatch?: MatchPrediction | null;
}

const { featuredMatch = null } = Astro.props;
const featuredOutcomes = featuredMatch
  ? [
      {
        label: featuredMatch.team_a.name,
        value: featuredMatch.probabilities.team_a_win,
      },
      {
        label: 'Empate',
        value: featuredMatch.probabilities.draw,
      },
      {
        label: featuredMatch.team_b.name,
        value: featuredMatch.probabilities.team_b_win,
      },
    ]
  : [];
const leadingOutcome = [...featuredOutcomes].sort((a, b) => b.value - a.value)[0] ?? null;
const expectedTotal = featuredMatch
  ? featuredMatch.expected_goals.team_a + featuredMatch.expected_goals.team_b
  : null;
---

<section class="worldcup-hero" data-reveal>
  <div class="hero-frame">
    <div class="hero-copy">
      <p class="eyebrow">Laboratorio público · Mundial 2026</p>
      <h1>Laboratorio Mundial 2026</h1>
      <p class="hero-lede">
        Predicciones del Mundial 2026 con un modelo probabilístico propio.
      </p>
      <p class="hero-note">
        Partidos, grupos, favoritos experimentales y auditoría pública después de cada resultado.
      </p>
      <div class="hero-actions">
        <a href="/mundial-2026/predicciones-hoy" class="button-primary">Ver predicciones</a>
        <a href="/mundial-2026/metodologia" class="button-secondary">Cómo funciona</a>
      </div>
      <div class="hero-badges" aria-label="Alcance del laboratorio">
        <span>Modelo propio</span>
        <span>Probabilidades, no certezas</span>
        <span>Auditoría pública</span>
      </div>
    </div>

    {featuredMatch && (
      <aside class="hero-match" aria-label="Partido destacado del modelo">
        <p class="card-label">Partido destacado</p>
        <div class="match-title">
          <TeamBadge id={featuredMatch.team_a.id} name={featuredMatch.team_a.name} />
          <span>vs</span>
          <TeamBadge id={featuredMatch.team_b.id} name={featuredMatch.team_b.name} />
        </div>
        <ProbabilityBar
          teamAWin={featuredMatch.probabilities.team_a_win}
          draw={featuredMatch.probabilities.draw}
          teamBWin={featuredMatch.probabilities.team_b_win}
          teamAName={featuredMatch.team_a.name}
          teamBName={featuredMatch.team_b.name}
        />
        <div class="match-insight">
          <div>
            <span>Mayor escenario</span>
            <strong>{leadingOutcome ? `${leadingOutcome.label} · ${formatPercent(leadingOutcome.value)}` : 'ND'}</strong>
          </div>
          <div>
            <span>Goles esperados</span>
            <strong>{expectedTotal !== null ? formatNumber(expectedTotal, 1) : 'ND'}</strong>
          </div>
        </div>
      </aside>
    )}
  </div>
</section>

<style>
  .worldcup-hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
    color: #ffffff;
    background:
      linear-gradient(90deg, rgba(1, 12, 24, 0.94) 0%, rgba(1, 20, 36, 0.86) 38%, rgba(1, 33, 52, 0.68) 66%, rgba(1, 12, 24, 0.82) 100%),
      linear-gradient(180deg, rgba(1, 8, 18, 0.72) 0%, rgba(1, 8, 18, 0.26) 42%, rgba(1, 8, 18, 0.9) 100%),
      url('/images/worldcup/stadium-hero.jpg');
    background-position: center center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .worldcup-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 24%, rgba(86, 180, 233, 0.18), transparent 28%),
      radial-gradient(circle at 74% 18%, rgba(255, 255, 255, 0.12), transparent 20%),
      linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
    background-size: auto, auto, 84px 84px, 84px 84px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92), transparent 82%);
    mix-blend-mode: screen;
    opacity: 0.78;
    pointer-events: none;
  }

  .worldcup-hero::after {
    content: "2026";
    position: absolute;
    right: max(1rem, calc((100vw - var(--container)) / 2));
    bottom: -0.18em;
    color: rgba(255, 255, 255, 0.075);
    font-family: var(--font-mono);
    font-size: clamp(7rem, 18vw, 18rem);
    font-weight: 700;
    line-height: 0.8;
    pointer-events: none;
  }

  .hero-frame {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(330px, 0.72fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    max-width: min(var(--container), calc(100vw - 2rem));
    min-height: min(680px, calc(100vh - 72px));
    margin: 0 auto;
    padding: clamp(4rem, 8vh, 6rem) 0 clamp(3.5rem, 6vh, 5rem);
  }

  .hero-copy {
    min-width: 0;
    display: grid;
    gap: 0;
  }

  .eyebrow {
    color: #9ed7ff;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-3);
  }

  h1 {
    max-width: 13ch;
    color: #ffffff;
    font-size: clamp(3rem, 5.5vw, 5rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-top: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero-lede {
    max-width: 580px;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    line-height: 1.35;
  }

  .hero-note {
    max-width: 600px;
    margin-top: var(--space-3);
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .button-primary,
  .button-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.15rem;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 800;
    text-decoration: none;
  }

  .button-primary {
    background: #ffffff;
    color: var(--wc-blue-deep) !important;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff !important;
    backdrop-filter: blur(14px);
  }

  .button-primary:hover,
  .button-secondary:hover {
    text-decoration: none;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-5);
  }

  .hero-badges span {
    padding: 0.42rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.86);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .hero-match {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding: clamp(1rem, 2.4vw, 1.45rem);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
  }

  .card-label,
  .match-insight span {
    color: var(--wc-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .match-title {
    display: grid;
    gap: 0.75rem;
  }

  .match-title > span {
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .match-insight {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .match-insight div {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.9rem;
    border: 1px solid var(--wc-border);
    border-radius: 18px;
    background: var(--wc-bg-3);
  }

  .match-insight strong {
    color: var(--wc-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  @media (max-width: 980px) {
    .hero-frame {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    h1 {
      max-width: 12ch;
    }
  }

  @media (max-width: 560px) {
    .hero-frame {
      padding: var(--space-7) 0 var(--space-6);
    }

    h1 {
      max-width: none;
      font-size: clamp(2.4rem, 13vw, 3.2rem);
    }

    .hero-actions {
      display: grid;
    }

    .hero-badges {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.2rem;
    }

    .hero-badges span {
      flex: 0 0 auto;
    }

    .match-insight {
      grid-template-columns: 1fr;
    }
  }
</style>
