---
import { formatNumber } from '../../lib/worldcup/format';

interface Props {
  teamAName: string;
  teamBName: string;
  teamAXg: number;
  teamBXg: number;
}

const { teamAName, teamBName, teamAXg, teamBXg } = Astro.props;
const total = teamAXg + teamBXg;
---

<div class="xg-box">
  <p class="box-label">Goles esperados</p>
  <div class="xg-total">
    <span>Total del partido</span>
    <strong>{formatNumber(total)}</strong>
  </div>
  <div class="xg-row">
    <span>{teamAName}</span>
    <strong>{formatNumber(teamAXg)}</strong>
  </div>
  <div class="xg-row">
    <span>{teamBName}</span>
    <strong>{formatNumber(teamBXg)}</strong>
  </div>
</div>

<style>
  .xg-box {
    display: grid;
    gap: 0.55rem;
    padding: var(--space-2);
    border: 1px solid var(--wc-border);
    border-radius: 18px;
    background: var(--wc-bg-3);
  }

  .box-label {
    color: var(--wc-muted);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
  }

  .xg-total,
  .xg-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: center;
  }

  .xg-total {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--wc-border);
  }

  span {
    min-width: 0;
    color: var(--wc-soft);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  strong {
    color: var(--wc-text);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
  }
</style>
