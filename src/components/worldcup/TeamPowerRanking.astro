---
import TeamBadge from './TeamBadge.astro';
import { formatNumber } from '../../lib/worldcup/format';
import type { TeamPowerRanking as Ranking } from '../../lib/worldcup/types';

interface Props {
  ranking: Ranking;
  limit?: number;
}

const { ranking, limit = 12 } = Astro.props;
const teams = ranking.teams.slice(0, limit);
---

<section class="ranking-section" data-reveal>
  <div class="section-header">
    <p class="eyebrow">Modelo</p>
    <h2>Ranking inicial de fuerza</h2>
    <p>
      Lectura agregada de ataque, defensa y forma reciente. No es una tabla de título: sirve como señal de fuerza para el modelo de partidos.
    </p>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Selección</th>
          <th>Grupo</th>
          <th>Ataque</th>
          <th>Defensa</th>
          <th>GF pond.</th>
          <th>GC pond.</th>
        </tr>
      </thead>
      <tbody>
        {teams.map((team) => (
          <tr>
            <th scope="row"><TeamBadge team_id={team.team_id} name={team.name} /></th>
            <td>{team.group ?? 'ND'}</td>
            <td>{formatNumber(team.attack_index, 2)}</td>
            <td>{formatNumber(team.defense_index, 2)}</td>
            <td>{formatNumber(team.weighted_goals_for_pg, 2)}</td>
            <td>{formatNumber(team.weighted_goals_against_pg, 2)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .ranking-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: 820px;
  }

  .eyebrow {
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  h2 {
    color: var(--wc-text);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--wc-soft);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--wc-border);
    border-radius: 24px;
    background: var(--wc-bg-2);
    box-shadow: 0 8px 30px rgba(24, 24, 27, 0.04);
  }

  table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--wc-border);
    color: var(--wc-soft);
    text-align: right;
    white-space: nowrap;
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  thead th {
    color: var(--wc-text);
    font-family: var(--font-ui);
    background: var(--wc-bg-3);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }
</style>
