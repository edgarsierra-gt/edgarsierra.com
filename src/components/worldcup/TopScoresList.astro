---
import { formatPercent } from '../../lib/worldcup/format';
import type { ScoreProbability } from '../../lib/worldcup/types';

interface Props {
  scores: ScoreProbability[];
  limit?: number;
}

const { scores, limit = 5 } = Astro.props;
const visibleScores = scores.slice(0, limit);
---

{visibleScores.length > 0 && (
  <div class="scores">
    <p class="scores-title">Marcadores más probables</p>
    <ol>
      {visibleScores.map((score) => (
        <li>
          <span>{score.score}</span>
          <strong>{formatPercent(score.probability, 1)}</strong>
        </li>
      ))}
    </ol>
    <p class="scores-note">
      El marcador exacto se muestra como referencia probabilística, no como certeza.
    </p>
  </div>
)}

<style>
  .scores {
    display: grid;
    gap: var(--space-1);
  }

  .scores-title,
  .scores-note {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  ol {
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }

  li:last-child {
    border-bottom: 0;
  }
</style>

