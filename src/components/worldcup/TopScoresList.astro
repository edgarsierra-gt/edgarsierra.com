---
import { formatPercent } from '../../lib/worldcup/format';
import type { ScoreProbability } from '../../lib/worldcup/types';

interface Props {
  scores: ScoreProbability[];
  limit?: number;
}

const { scores, limit = 5 } = Astro.props;
const visibleScores = scores.slice(0, limit);
---

{visibleScores.length > 0 && (
  <div class="scores">
    <p class="scores-title">Marcadores más probables</p>
    <ol>
      {visibleScores.map((score) => (
        <li>
          <span>{score.score}</span>
          <strong>{formatPercent(score.probability, 1)}</strong>
        </li>
      ))}
    </ol>
    <p class="scores-note">
      Referencia probabilística: cada marcador individual suele tener baja frecuencia.
    </p>
  </div>
)}

<style>
  .scores {
    display: grid;
    gap: var(--space-1);
  }

  .scores-title,
  .scores-note {
    color: var(--wc-muted);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
  }

  ol {
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }

  li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--wc-border);
    border-radius: 12px;
    background: var(--wc-bg-3);
    color: var(--wc-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  strong {
    color: var(--wc-blue);
  }
</style>
