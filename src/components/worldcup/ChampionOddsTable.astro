---
import { formatBracketMode, formatPercent } from '../../lib/worldcup/format';
import type { ChampionOdds } from '../../lib/worldcup/types';

interface Props {
  odds: ChampionOdds;
  limit?: number;
}

const { odds, limit = 12 } = Astro.props;
const teams = odds.teams.slice(0, limit);
---

<section class="champion-section" data-reveal>
  <div class="section-header">
    <p class="eyebrow">Monte Carlo</p>
    <h2>Probabilidad experimental de campeon</h2>
    <p>
      Estas probabilidades indican cuantas veces aparece cada seleccion como campeona en {odds.n_simulations.toLocaleString('es-GT')} simulaciones. No dicen quien va a ganar.
    </p>
    <p class="mode-note">{formatBracketMode(odds.bracket_mode)}. Se refinara cuando el bracket oficial completo este validado.</p>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Equipo</th>
          <th>Grupo</th>
          <th>Campeon</th>
          <th>Final</th>
          <th>Semis</th>
        </tr>
      </thead>
      <tbody>
        {teams.map((team) => (
          <tr>
            <td>{team.rank}</td>
            <th scope="row">{team.name}</th>
            <td>{team.group}</td>
            <td>{formatPercent(team.prob_champion, 1)}</td>
            <td>{formatPercent(team.prob_final, 1)}</td>
            <td>{formatPercent(team.prob_semifinal, 1)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .champion-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: var(--reading);
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--accent);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  h2 {
    font-size: var(--text-2xl);
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .section-header p {
    color: var(--ink-muted);
  }

  .mode-note {
    font-size: var(--text-sm);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--border);
    text-align: right;
    white-space: nowrap;
  }

  th:nth-child(2),
  td:nth-child(2) {
    text-align: left;
  }

  thead th {
    font-family: var(--font-ui);
    color: var(--ink);
    background: var(--code-bg);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
