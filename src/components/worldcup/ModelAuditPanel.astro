---
import { formatNumber, formatPercentOptional } from '../../lib/worldcup/format';
import type { ModelAudit, ModelCalibration } from '../../lib/worldcup/types';

interface Props {
  audit: ModelAudit;
  calibration: ModelCalibration;
}

const { audit, calibration } = Astro.props;
const metrics = audit.metrics;
---

<section class="audit-section" data-reveal>
  <div class="section-header">
    <p class="eyebrow">Auditoria</p>
    <h2>Como va el modelo</h2>
    <p>
      Las predicciones se evalúan contra resultados reales usando metricas probabilisticas. Cuando aun no hay cruce entre predicciones congeladas y resultados, el panel lo muestra sin maquillar la muestra.
    </p>
  </div>

  <div class="metric-grid">
    <div class="metric">
      <span>Partidos auditados</span>
      <strong>{audit.matches_audited}</strong>
    </div>
    <div class="metric">
      <span>Accuracy 1X2</span>
      <strong>{formatPercentOptional(metrics.accuracy_1x2, 1)}</strong>
    </div>
    <div class="metric">
      <span>Brier score</span>
      <strong>{formatNumber(metrics.brier_score, 3)}</strong>
    </div>
    <div class="metric">
      <span>Log loss</span>
      <strong>{formatNumber(metrics.log_loss, 3)}</strong>
    </div>
    <div class="metric">
      <span>Marcador exacto</span>
      <strong>{formatPercentOptional(metrics.exact_score_hit_rate, 1)}</strong>
    </div>
    <div class="metric">
      <span>Sesgo de goles</span>
      <strong>{formatNumber(metrics.goals_bias, 2)}</strong>
    </div>
  </div>

  {audit.by_confidence_bin.length > 0 ? (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Confianza</th>
            <th>N</th>
            <th>Prob. media</th>
            <th>Frecuencia real</th>
          </tr>
        </thead>
        <tbody>
          {audit.by_confidence_bin.map((bin) => (
            <tr>
              <th scope="row">{bin.bin}%</th>
              <td>{bin.n}</td>
              <td>{formatPercentOptional(bin.avg_confidence, 1)}</td>
              <td>{formatPercentOptional(bin.actual_hit_rate, 1)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="empty-state">Todavia no hay suficientes partidos auditables para construir bins de calibracion.</p>
  )}

  <div class="notes">
    {audit.notes.map((note) => <p>{note}</p>)}
    <p>
      Goles: predicho {formatNumber(calibration.goals.mean_predicted_total, 2)} vs real {formatNumber(calibration.goals.mean_actual_total, 2)}.
    </p>
  </div>
</section>

<style>
  .audit-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: var(--reading);
  }

  .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--accent);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  h2 {
    font-size: var(--text-2xl);
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .section-header p,
  .notes,
  .empty-state {
    color: var(--ink-muted);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-2);
  }

  .metric {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .metric span {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .metric strong {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    color: var(--ink);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--border);
    text-align: right;
    white-space: nowrap;
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  thead th {
    font-family: var(--font-ui);
    color: var(--ink);
    background: var(--code-bg);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .empty-state {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .notes {
    display: grid;
    gap: var(--space-1);
    max-width: var(--reading);
    font-size: var(--text-sm);
  }
</style>
