---
import { formatNumber, formatPercentOptional } from '../../lib/worldcup/format';
import type { ModelAudit, ModelCalibration } from '../../lib/worldcup/types';

interface Props {
  audit: ModelAudit;
  calibration: ModelCalibration;
}

const { audit, calibration } = Astro.props;
const metrics = audit.metrics;
---

<section class="audit-section" data-reveal>
  <div class="section-header">
    <p class="eyebrow">Auditoría</p>
    <h2>Una predicción útil no solo se publica: se audita.</h2>
    <p>
      Las predicciones se comparan contra resultados reales usando métricas probabilísticas. Si todavía no hay muestra suficiente, el panel lo muestra sin maquillar la lectura.
    </p>
  </div>

  <div class="metric-grid">
    <div class="metric">
      <span>Partidos auditados</span>
      <strong>{audit.matches_audited}</strong>
    </div>
    <div class="metric">
      <span>Accuracy 1X2</span>
      <strong>{formatPercentOptional(metrics.accuracy_1x2, 1)}</strong>
    </div>
    <div class="metric">
      <span>Brier score</span>
      <strong>{formatNumber(metrics.brier_score, 3)}</strong>
    </div>
    <div class="metric">
      <span>Log loss</span>
      <strong>{formatNumber(metrics.log_loss, 3)}</strong>
    </div>
    <div class="metric">
      <span>Marcador exacto</span>
      <strong>{formatPercentOptional(metrics.exact_score_hit_rate, 1)}</strong>
    </div>
    <div class="metric">
      <span>Bias de goles</span>
      <strong>{formatNumber(metrics.goals_bias, 2)}</strong>
    </div>
  </div>

  {audit.by_confidence_bin.length > 0 ? (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Confianza</th>
            <th>N</th>
            <th>Prob. media</th>
            <th>Frecuencia real</th>
          </tr>
        </thead>
        <tbody>
          {audit.by_confidence_bin.map((bin) => (
            <tr>
              <th scope="row">{bin.bin}%</th>
              <td>{bin.n}</td>
              <td>{formatPercentOptional(bin.avg_confidence, 1)}</td>
              <td>{formatPercentOptional(bin.actual_hit_rate, 1)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="audit-empty">
      <strong>Calibración pendiente</strong>
      <p>Todavía no hay suficientes partidos auditables para construir bins de calibración.</p>
    </div>
  )}

  <div class="notes">
    {audit.notes.map((note) => <p>{note}</p>)}
    <p>
      Goles: predicho {formatNumber(calibration.goals.mean_predicted_total, 2)} vs real {formatNumber(calibration.goals.mean_actual_total, 2)}.
    </p>
  </div>
</section>

<style>
  .audit-section {
    display: grid;
    gap: var(--space-4);
  }

  .section-header {
    max-width: var(--reading);
  }

  .eyebrow {
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  h2 {
    color: var(--wc-text);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .section-header p,
  .notes,
  .audit-empty p {
    color: var(--wc-soft);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-2);
  }

  .metric {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-3);
    border: 1px solid var(--wc-border);
    border-radius: 20px;
    background: var(--wc-bg-2);
    box-shadow: 0 4px 12px rgba(24, 24, 27, 0.03);
  }

  .audit-empty {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-3);
    border: 1px solid var(--wc-border);
    border-radius: 20px;
    background: var(--wc-bg-2);
    box-shadow: 0 4px 12px rgba(24, 24, 27, 0.03);
    max-width: var(--reading);
  }

  .metric span {
    color: var(--wc-muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .metric strong,
  .audit-empty strong {
    color: var(--wc-text);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--wc-border);
    border-radius: 22px;
    background: var(--wc-bg-2);
    box-shadow: 0 4px 18px rgba(24, 24, 27, 0.03);
  }

  table {
    width: 100%;
    min-width: 540px;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-2);
    border-bottom: 1px solid var(--wc-border);
    color: var(--wc-soft);
    text-align: right;
    white-space: nowrap;
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  thead th {
    color: var(--wc-text);
    font-family: var(--font-ui);
    background: var(--wc-bg-3);
  }

  tbody th {
    font-family: var(--font-ui);
    font-weight: 600;
  }

  .notes {
    display: grid;
    gap: var(--space-1);
    max-width: var(--reading);
    font-size: var(--text-sm);
  }
</style>
