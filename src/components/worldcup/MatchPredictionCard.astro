---
import ExpectedGoalsBox from './ExpectedGoalsBox.astro';
import ProbabilityBar from './ProbabilityBar.astro';
import TeamBadge from './TeamBadge.astro';
import TopScoresList from './TopScoresList.astro';
import { formatDateShort, getPredictionLabel, isPlaceholderValue } from '../../lib/worldcup/format';
import type { MatchPrediction } from '../../lib/worldcup/types';

interface Props {
  match: MatchPrediction;
  featured?: boolean;
  linkToDetail?: boolean;
}

const { match, featured = false, linkToDetail = true } = Astro.props;
const predictionLabel = getPredictionLabel(
  match.predicted_result,
  match.team_a.name,
  match.team_b.name,
);
const hasTime = !isPlaceholderValue(match.time_local);
const hasVenue = !isPlaceholderValue(match.venue);

const detailHref = `/mundial-2026/partido/${match.team_a.slug}-vs-${match.team_b.slug}`;
const Wrapper = linkToDetail ? 'a' : 'div';
const wrapperAttrs = linkToDetail
  ? { href: detailHref, 'aria-label': `Ver análisis completo: ${match.team_a.name} vs ${match.team_b.name}` }
  : {};
---

{/* Nota: toda la tarjeta se envuelve en <a> cuando linkToDetail=true — no agregar <a>/<button> en componentes hijos (ProbabilityBar, TeamBadge, ExpectedGoalsBox, TopScoresList) para evitar enlaces anidados. */}
<Wrapper class:list={['match-card', { featured }]} {...wrapperAttrs}>
  <header class="match-header">
    <p class="match-meta">
      {match.group && <span>Grupo {match.group}</span>}
      <span>{formatDateShort(match.date)}</span>
      {hasTime && <span>{match.time_local}</span>}
    </p>
    <div class="teams-row">
      <TeamBadge id={match.team_a.id} name={match.team_a.name} />
      <span class="versus">vs</span>
      <TeamBadge id={match.team_b.id} name={match.team_b.name} />
    </div>
    {hasVenue && <p class="venue">{match.venue}</p>}
  </header>

  <ProbabilityBar
    teamAWin={match.probabilities.team_a_win}
    draw={match.probabilities.draw}
    teamBWin={match.probabilities.team_b_win}
    teamAName={match.team_a.name}
    teamBName={match.team_b.name}
  />

  <div class="prediction-row">
    <div>
      <span>Lectura del modelo</span>
      <strong>{predictionLabel}</strong>
    </div>
    <div>
      <span>Confianza</span>
      <strong>{match.confidence_label}</strong>
    </div>
  </div>

  <ExpectedGoalsBox
    teamAName={match.team_a.name}
    teamBName={match.team_b.name}
    teamAXg={match.expected_goals.team_a}
    teamBXg={match.expected_goals.team_b}
  />

  <TopScoresList scores={match.top_scores} limit={featured ? 5 : 3} />

  {match.notes && <p class="match-note">{match.notes}</p>}

  {linkToDetail && <p class="detail-cta">Ver análisis completo →</p>}
</Wrapper>

<style>
  .match-card {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--wc-border);
    border-radius: 24px;
    background: var(--wc-bg-2);
    box-shadow: 0 8px 30px rgba(24, 24, 27, 0.04);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  a.match-card:hover {
    border-color: var(--wc-blue);
    box-shadow: 0 12px 36px rgba(0, 114, 178, 0.1);
    text-decoration: none;
  }

  .featured {
    border-color: var(--wc-blue);
    box-shadow: 0 12px 36px rgba(0, 114, 178, 0.08);
  }

  .match-header {
    display: grid;
    gap: var(--space-2);
  }

  .match-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--wc-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .match-meta span + span::before {
    content: "· ";
    color: var(--wc-muted);
  }

  .teams-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-2);
    align-items: center;
  }

  .versus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--wc-border);
    border-radius: 999px;
    background: var(--wc-bg-3);
    color: var(--wc-blue);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .venue {
    color: var(--wc-muted);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .prediction-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .prediction-row div {
    min-width: 0;
    padding: var(--space-2);
    border: 1px solid var(--wc-border);
    border-radius: 16px;
    background: var(--wc-bg-3);
  }

  .prediction-row span {
    display: block;
    color: var(--wc-muted);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
  }

  .prediction-row strong {
    display: block;
    margin-top: 0.2rem;
    color: var(--wc-text);
    font-family: var(--font-ui);
    overflow-wrap: anywhere;
  }

  .match-note {
    color: var(--wc-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .detail-cta {
    color: var(--wc-blue);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .match-card {
      background: var(--wc-bg-2);
    }
  }

  @media (max-width: 560px) {
    .teams-row {
      grid-template-columns: 1fr;
    }

    .versus {
      width: auto;
      height: auto;
      justify-self: start;
      padding: 0.35rem 0.65rem;
    }

    .prediction-row {
      grid-template-columns: 1fr;
    }
  }
</style>
