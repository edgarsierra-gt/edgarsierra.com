---
interface Props {
  label: string;
  value: string | number;
  detail?: string;
}

const { label, value, detail } = Astro.props;
---

<article class="stat-card">
  <span>{label}</span>
  <strong>{value}</strong>
  {detail && <p>{detail}</p>}
</article>

<style>
  .stat-card {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--wc-border);
    border-radius: 22px;
    background: var(--wc-bg-2);
    box-shadow: 0 8px 24px rgba(24, 24, 27, 0.04);
  }

  span {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--wc-muted);
  }

  strong {
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 3vw, 2rem);
    color: var(--wc-text);
    overflow-wrap: anywhere;
  }

  p {
    color: var(--wc-soft);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
</style>
