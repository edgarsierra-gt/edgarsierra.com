---
// Hero data-science visualization: a deterministic scatter plot with a real
// ordinary-least-squares regression line and an illustrative confidence band.
// Built at SSG time with a seeded PRNG, so every build renders identically.
// All colors come from design tokens (Okabe-Ito, colorblind-safe).

const W = 460;
const H = 380;
const PAD = { l: 30, r: 16, t: 22, b: 26 };
const plotW = W - PAD.l - PAD.r;
const plotH = H - PAD.t - PAD.b;

// Seeded linear congruential generator → deterministic "noise".
function makeRng(seed: number): () => number {
  let s = seed >>> 0;
  return () => {
    s = (1664525 * s + 1013904223) >>> 0;
    return s / 4294967296;
  };
}
const rng = makeRng(7);

const N = 32;
const M_TRUE = 0.66;
const B_TRUE = 1.7;
const NOISE = 1.3;

type Pt = { x: number; y: number };
const pts: Pt[] = [];
for (let i = 0; i < N; i++) {
  const x = 0.5 + (i + rng() * 0.7) * (9 / N);
  const yRaw = M_TRUE * x + B_TRUE + (rng() * 2 - 1) * NOISE;
  pts.push({ x, y: Math.max(0.3, Math.min(9.7, yRaw)) });
}

// Ordinary least squares fit.
const n = pts.length;
const meanX = pts.reduce((a, p) => a + p.x, 0) / n;
const meanY = pts.reduce((a, p) => a + p.y, 0) / n;
let sxy = 0;
let sxx = 0;
for (const p of pts) {
  sxy += (p.x - meanX) * (p.y - meanY);
  sxx += (p.x - meanX) ** 2;
}
const slope = sxy / sxx;
const intercept = meanY - slope * meanX;

// Domain → pixel mappers (y axis inverted for SVG).
const DX: [number, number] = [0, 10];
const DY: [number, number] = [0, 10];
const mapX = (x: number) => PAD.l + ((x - DX[0]) / (DX[1] - DX[0])) * plotW;
const mapY = (y: number) => PAD.t + (1 - (y - DY[0]) / (DY[1] - DY[0])) * plotH;

// Regression line endpoints across the full domain.
const px1 = mapX(DX[0]);
const py1 = mapY(slope * DX[0] + intercept);
const px2 = mapX(DX[1]);
const py2 = mapY(slope * DX[1] + intercept);
const lineLen = Math.hypot(px2 - px1, py2 - py1);

// Illustrative confidence band — widens away from x̄, like a real CI.
const STEPS = 26;
const upper: [number, number][] = [];
const lower: [number, number][] = [];
for (let i = 0; i <= STEPS; i++) {
  const x = DX[0] + (i / STEPS) * (DX[1] - DX[0]);
  const yhat = slope * x + intercept;
  const w = 0.45 + 1.5 * Math.sqrt(0.12 + ((x - meanX) / (DX[1] - DX[0])) ** 2 * 3);
  upper.push([mapX(x), mapY(yhat + w)]);
  lower.push([mapX(x), mapY(yhat - w)]);
}
const fmt = ([x, y]: [number, number]) => `${x.toFixed(1)},${y.toFixed(1)}`;
const bandPath =
  'M' + upper.map(fmt).join(' L') +
  ' L' + [...lower].reverse().map(fmt).join(' L') + ' Z';

// Subtle gridlines.
const gridY = [2, 4, 6, 8].map((v) => mapY(v));
const gridX = [2, 4, 6, 8].map((v) => mapX(v));
---

<svg
  class="hero-viz"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="Diagrama de dispersión con una recta de regresión por mínimos cuadrados y una banda de confianza ilustrativa."
>
  <!-- Cuadrícula sutil -->
  <g class="grid" aria-hidden="true">
    {gridY.map((y) => (
      <line x1={mapX(0)} y1={y} x2={mapX(10)} y2={y} />
    ))}
    {gridX.map((x) => (
      <line x1={x} y1={mapY(0)} x2={x} y2={mapY(10)} />
    ))}
  </g>

  <!-- Ejes -->
  <g class="axes" aria-hidden="true">
    <line x1={mapX(0)} y1={mapY(0)} x2={mapX(10)} y2={mapY(0)} />
    <line x1={mapX(0)} y1={mapY(0)} x2={mapX(0)} y2={mapY(10)} />
  </g>

  <!-- Banda de confianza -->
  <path class="ci-band" d={bandPath} />

  <!-- Recta de regresión -->
  <line
    class="reg-line"
    x1={px1}
    y1={py1}
    x2={px2}
    y2={py2}
    style={`--draw-len:${lineLen.toFixed(1)}`}
  />

  <!-- Puntos -->
  {pts.map((p, i) => (
    <circle class="pt" cx={mapX(p.x)} cy={mapY(p.y)} r="4.5" style={`--i:${i}`} />
  ))}
</svg>

<style>
  .hero-viz {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .grid line {
    stroke: var(--border);
    stroke-width: 1;
    opacity: 0.6;
  }

  .axes line {
    stroke: var(--ink-muted);
    stroke-width: 1.5;
    opacity: 0.5;
  }

  .ci-band {
    fill: var(--c-vermilion);
    opacity: 0.12;
  }

  .reg-line {
    stroke: var(--c-vermilion);
    stroke-width: 2.5;
    stroke-linecap: round;
    fill: none;
  }

  .pt {
    fill: var(--accent);
    opacity: 0.82;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Animación de entrada: banda → recta se traza → puntos aparecen.
     Sólo bajo no-preference; en reduce todo queda en su estado final. */
  @media (prefers-reduced-motion: no-preference) {
    .grid,
    .axes {
      opacity: 0;
      animation: es-fade-in 0.8s ease 0.1s forwards;
    }

    .ci-band {
      opacity: 0;
      animation: ci-reveal 1s ease 0.35s forwards;
    }

    .reg-line {
      stroke-dasharray: var(--draw-len);
      stroke-dashoffset: var(--draw-len);
      animation: es-draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.6s forwards;
    }

    .pt {
      opacity: 0;
      animation: pt-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      animation-delay: calc(0.85s + var(--i) * 22ms);
    }
  }

  @keyframes ci-reveal {
    to { opacity: 0.12; }
  }

  @keyframes pt-pop {
    from { opacity: 0; transform: scale(0); }
    to   { opacity: 0.82; transform: scale(1); }
  }
</style>
