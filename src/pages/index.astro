---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Edgar Sierra — Head of BI & Data Science"
  description="Estadística rigurosa e IA aplicadas a problemas reales de Guatemala y Centroamérica. Blog, proyectos y newsletter."
>
  <section class="hero">
    <h1 class="hero-title">
      Estadística rigurosa e IA aplicadas a problemas reales de Guatemala y Centroamérica.
    </h1>
    <p class="hero-subtitle">
      Análisis de datos, ingeniería en GCP e investigación con rigor estadístico.
      Contenido pensado para profesionales de datos en la región.
    </p>
    <div class="hero-actions">
      <a href="/blog" class="btn btn-primary">Leer el blog</a>
      <a href="/newsletter" class="btn btn-secondary">Suscribirse</a>
    </div>
    <div class="pillar-chips">
      <span class="chip chip-1">Política y datos</span>
      <span class="chip chip-2">Marketing analytics</span>
      <span class="chip chip-3">Ingeniería GCP</span>
      <span class="chip chip-4">IA aplicada</span>
      <span class="chip chip-5">Estadística</span>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ────────────────────────────────────────────────── */
  .hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    max-width: var(--reading);
  }

  .hero-title {
    font-family: var(--font-ui);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--ink);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: var(--leading-body);
    margin-bottom: var(--space-6);
    max-width: 54ch;
  }

  /* ── Buttons ─────────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .btn {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 500;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    text-decoration: none;
    border: 2px solid var(--accent);
    transition: opacity 0.15s;
  }

  .btn:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .btn-primary {
    background-color: var(--accent);
    color: #fff;
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--accent);
  }

  /* ── Pillar chips ────────────────────────────────────────── */
  .pillar-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.3em var(--space-2);
    border-radius: calc(var(--radius) / 2);
    border: 1.5px solid currentColor;
    background-color: transparent;
    letter-spacing: 0.01em;
  }

  .chip-1 { color: var(--pillar-1); }
  .chip-2 { color: var(--pillar-2); }
  .chip-3 { color: var(--pillar-3); }
  .chip-4 { color: var(--pillar-4); }
  .chip-5 { color: var(--pillar-5); }

  /* ── Mobile ──────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-8);
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
