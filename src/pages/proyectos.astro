---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Proyectos — Edgar Sierra"
  description="Trabajo técnico en producción: pipelines ETL, infraestructura GCP y el backend de este sitio como case study de ingeniería."
>
  <div class="projects-page">
    <header class="page-header">
      <h1 class="page-title">Proyectos</h1>
      <p class="page-subtitle">
        Trabajo técnico en producción, documentado con rigor. Pipelines, APIs e
        infraestructura GCP aplicados a problemas reales.
      </p>
    </header>

    <div class="projects-grid">
      {projects.map(project => (
        <article class:list={['project-card', { 'card-featured': project.data.featured }]}>
          <div class="card-badges">
            {project.data.featured && (
              <span class="badge badge-featured">Destacado</span>
            )}
            {project.data.caseStudy && (
              <span class="badge badge-case-study">Case study</span>
            )}
          </div>

          <h2 class="project-title">{project.data.title}</h2>

          {project.data.role && (
            <p class="project-role">{project.data.role}</p>
          )}

          <p class="project-summary">{project.data.summary}</p>

          <div class="stack-chips">
            {project.data.stack.map(tech => (
              <span class="stack-chip">{tech}</span>
            ))}
          </div>

          {project.data.links.length > 0 && (
            <div class="project-links">
              {project.data.links.map(link => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                >
                  {link.label} →
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .page-header {
    max-width: var(--reading);
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-family: var(--font-ui);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: var(--leading-body);
  }

  /* ── Grid ────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-featured {
    border-color: var(--accent);
    border-width: 1.5px;
  }

  /* ── Badges ──────────────────────────────── */
  .card-badges {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    min-height: 1.4rem;
  }

  .badge {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.2em var(--space-2);
    border-radius: calc(var(--radius) / 2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .badge-featured {
    background: var(--accent);
    color: #fff;
  }

  .badge-case-study {
    background: var(--accent-2);
    color: #fff;
  }

  /* ── Content ─────────────────────────────── */
  .project-title {
    font-family: var(--font-ui);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--ink);
    line-height: var(--leading-tight);
  }

  .project-role {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    font-style: italic;
  }

  .project-summary {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.6;
    flex: 1;
  }

  /* ── Stack chips ─────────────────────────── */
  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .stack-chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) / 2);
    padding: 0.2em var(--space-2);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  /* ── Links ───────────────────────────────── */
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .project-link {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
