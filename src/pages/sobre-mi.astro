---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHARLAS } from '../data/charlas';
import { SOCIALS } from '../data/socials';

const personLD = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Edgar Sierra',
  givenName: 'Edgar',
  familyName: 'Sierra',
  jobTitle: 'Head of BI & Data Science',
  url: 'https://edgarsierra.com/sobre-mi',
  sameAs: [
    SOCIALS.github,
    SOCIALS.linkedin,
    SOCIALS.medium,
    SOCIALS.twitter,
  ],
};

const stackCategories = [
  {
    label: 'Ingeniería de datos',
    items: ['Python', 'BigQuery', 'Apache Airflow', 'dbt', 'Pub/Sub', 'Pandas'],
  },
  {
    label: 'Infraestructura GCP',
    items: ['Cloud Run', 'Firestore', 'Secret Manager', 'GitHub Actions', 'WIF', 'Docker'],
  },
  {
    label: 'Estadística y ML',
    items: ['scikit-learn', 'PyMC', 'statsmodels', 'NumPy', 'SciPy'],
  },
  {
    label: 'BI y visualización',
    items: ['Looker Studio', 'Power BI', 'Matplotlib', 'Plotly'],
  },
  {
    label: 'Este sitio',
    items: ['Astro', 'MDX', 'FastAPI', 'Claude Code'],
  },
];

const timeline = [
  {
    year: 'Presente',
    items: ['Head of BI & Data Science en Aumenta Intelligence'],
  },
  {
    year: '2026',
    items: [
      'Tesis de maestría en proceso de publicación — Revista de la Escuela de Estudios de Postgrado, USAC',
      'Lanzamiento de edgarsierra.com',
    ],
  },
  {
    year: '2024',
    items: [
      'Taller de Análisis de Datos y Series de Tiempo — Congreso Regional de Ingeniería, CUNOR-USAC',
    ],
  },
  {
    year: '2021',
    items: [
      'Auxiliar de Investigación II en la Dirección General de Investigación (DIGI-USAC)',
      'Coautoría y análisis estadístico en 3 investigaciones publicadas sobre adsorbentes orgánicos y optimización de café',
    ],
  },
];
---

<BaseLayout
  title="Sobre mí — Edgar Sierra"
  description="Edgar Sierra: Head of BI & Data Science. Estadística rigurosa, ingeniería GCP e IA aplicada a problemas reales de Guatemala y Centroamérica."
  jsonLd={[personLD]}
>
  <div class="sobre-page">

    <!-- ── Bio ───────────────────────────────── -->
    <section class="bio-section" data-reveal>
      <div class="bio-content">
        <div class="avatar-wrap">
          <img
            src="/images/edgar-sierra.jpg"
            alt="Foto de Edgar Sierra"
            class="avatar-img"
            width="80"
            height="80"
          />
        </div>
        <div class="bio-text">
          <h1 class="bio-name">Edgar Sierra</h1>
          <p class="bio-role">Head of BI & Data Science · Aumenta Intelligence</p>

          <p>
            Soy Edgar Sierra, estadístico aplicado y Head of BI & Data Science en una
            agencia de marketing digital en Guatemala. Construyo modelos de machine
            learning y arquitecturas de datos en GCP que llegan a producción, no que
            se quedan en un notebook. Me obsesiona aplicar estadística rigurosa a
            problemas reales del contexto centroamericano: política, marketing y
            economía local. Hice una maestría en Estadística Aplicada (Cum Laude) con
            una tesis sobre la eficiencia de la publicidad política en Meta durante las
            elecciones de Guatemala 2023, en proceso de publicación en la Revista de la
            Escuela de Estudios de Postgrado de la USAC. Acá escribo sobre lo que
            aprendo midiendo cosas que a casi nadie más se le ocurre medir en esta
            región.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Stack ─────────────────────────────── -->
    <section class="stack-section">
      <h2 class="section-title" data-reveal>Stack en producción</h2>
      <div class="stack-grid">
        {stackCategories.map((cat, i) => (
          <div class="stack-category" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <h3 class="cat-label">{cat.label}</h3>
            <div class="tech-chips">
              {cat.items.map(tech => (
                <span class="tech-chip">{tech}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Timeline ───────────────────────────── -->
    <section class="timeline-section">
      <h2 class="section-title" data-reveal>Línea de tiempo</h2>
      <div class="timeline" data-reveal>
        {timeline.map(entry => (
          <div class="timeline-entry">
            <span class="tl-year">{entry.year}</span>
            <ul class="tl-items">
              {entry.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Charlas embebidas ───────────────────── -->
    <section class="charlas-section">
      <h2 class="section-title" data-reveal>Charlas</h2>
      <div class="charlas-list">
        {CHARLAS.map((charla, i) => (
          <article class="charla-item" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <div class="charla-meta">
              <span class="charla-year">{charla.year}</span>
              <span class="charla-type">{charla.type}</span>
            </div>
            <h3 class="charla-title">{charla.title}</h3>
            <p class="charla-event">{charla.event} — {charla.organization}</p>
          </article>
        ))}
      </div>
      <a href="/charlas" class="ver-mas">Ver todas las charlas →</a>
    </section>

    <!-- ── CTAs ───────────────────────────────── -->
    <section class="cta-section" data-reveal>
      <div class="cta-grid">
        <a href="/newsletter" class="cta-card cta-primary">
          <strong>Newsletter mensual</strong>
          <p>Análisis de datos, GCP e IA aplicados a Centroamérica. Sin spam.</p>
        </a>
        <a href="/contacto" class="cta-card cta-secondary">
          <strong>Contacto</strong>
          <p>¿Proyecto, consulta o propuesta de charla? Escribime.</p>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .sobre-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    max-width: var(--reading);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  /* ── Secciones ───────────────────────────── */
  .section-title {
    font-family: var(--font-ui);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  /* ── Bio ─────────────────────────────────── */
  .bio-content {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .avatar-wrap {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border);
    background: var(--code-bg);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .bio-name {
    font-family: var(--font-ui);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .bio-role {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--ink-muted);
    margin-top: calc(-1 * var(--space-2));
  }

  .bio-text p {
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--ink);
  }

  /* ── Stack grid ──────────────────────────── */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .stack-category {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
  }

  .cat-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tech-chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) / 2);
    padding: 0.2em var(--space-2);
    color: var(--ink-muted);
  }

  /* ── Timeline ────────────────────────────── */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    padding-left: var(--space-5);
    margin-left: var(--space-2);
  }

  /* Línea vertical — se dibuja al entrar en vista (sólo con JS) */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
    transform-origin: top;
  }

  .has-js .timeline::before {
    transform: scaleY(0);
  }

  .timeline.is-visible::before {
    transform: scaleY(1);
  }

  .timeline-entry {
    position: relative;
    padding-bottom: var(--space-5);
  }

  .timeline-entry::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-5) - 5px);
    top: 0.45em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1.5px var(--accent);
  }

  /* La línea crece y los puntos aparecen en secuencia */
  @media (prefers-reduced-motion: no-preference) {
    .has-js .timeline::before {
      transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
    }

    .has-js .timeline .timeline-entry::before {
      opacity: 0;
      transform: scale(0);
    }

    .timeline.is-visible .timeline-entry::before {
      animation: tl-dot 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    .timeline.is-visible .timeline-entry:nth-child(1)::before { animation-delay: 0.35s; }
    .timeline.is-visible .timeline-entry:nth-child(2)::before { animation-delay: 0.55s; }
    .timeline.is-visible .timeline-entry:nth-child(3)::before { animation-delay: 0.75s; }
  }

  @keyframes tl-dot {
    from { opacity: 0; transform: scale(0); }
    to   { opacity: 1; transform: scale(1); }
  }

  .tl-year {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--space-1);
  }

  .tl-items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .tl-items li {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--ink);
    line-height: 1.5;
  }

  /* ── Charlas embebidas ───────────────────── */
  .charlas-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .charla-item {
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .charla-meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .charla-year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .charla-type {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    padding: 0.2em var(--space-2);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) / 2);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .charla-title {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink);
  }

  .charla-event {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .ver-mas {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  .ver-mas:hover { text-decoration: underline; }

  /* ── CTAs ────────────────────────────────── */
  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .cta-card {
    padding: var(--space-5);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }

  .cta-card:hover {
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 114, 178, 0.12);
    transform: translateY(-3px);
  }

  .cta-primary {
    background: var(--accent);
    border-color: var(--accent);
  }

  .cta-primary strong,
  .cta-primary p {
    color: #fff;
  }

  .cta-secondary {
    background: var(--surface);
  }

  .cta-secondary strong {
    color: var(--ink);
  }

  .cta-secondary p {
    color: var(--ink-muted);
  }

  .cta-card strong {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .cta-card p {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* ── Mobile ──────────────────────────────── */
  @media (max-width: 640px) {
    .bio-content {
      flex-direction: column;
      gap: var(--space-4);
    }

    .stack-grid {
      grid-template-columns: 1fr;
    }

    .cta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
