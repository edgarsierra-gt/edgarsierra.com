---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHARLAS } from '../data/charlas';
---

<BaseLayout
  title="Charlas — Edgar Sierra"
  description="Ponencias y talleres de Edgar Sierra sobre análisis de datos, estadística y GCP."
>
  <div class="charlas-page">
    <header class="page-header">
      <h1 class="page-title">Charlas</h1>
      <p class="page-subtitle">
        Talleres y ponencias sobre datos, estadística e ingeniería GCP.
        ¿Querés invitarme a tu evento?{' '}
        <a href="/contacto">Escribime</a>.
      </p>
    </header>

    <div class="charlas-list">
      {CHARLAS.map(charla => (
        <article class="charla-item">
          <div class="charla-meta">
            <span class="charla-year">{charla.year}</span>
            <span class="charla-type">{charla.type}</span>
          </div>
          <h2 class="charla-title">{charla.title}</h2>
          <p class="charla-event">
            {charla.event} — {charla.organization}
          </p>
          {charla.description && (
            <p class="charla-desc">{charla.description}</p>
          )}
          {charla.slides && (
            <a href={charla.slides} class="charla-link" rel="noopener noreferrer">
              Ver slides →
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .charlas-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    max-width: var(--reading);
    margin-inline: auto;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-family: var(--font-ui);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: var(--leading-body);
  }

  .charlas-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .charla-item {
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .charla-meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .charla-year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .charla-type {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.2em var(--space-2);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) / 2);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .charla-title {
    font-family: var(--font-ui);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--ink);
    line-height: var(--leading-tight);
  }

  .charla-event {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .charla-desc {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: var(--leading-body);
  }

  .charla-link {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    align-self: flex-start;
  }

  .charla-link:hover { text-decoration: underline; }
</style>
