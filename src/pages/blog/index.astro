---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import SearchBox from '../../components/SearchBox.astro';
import { PILLARS } from '../../lib/pillars';

const allPosts = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);

const posts = allPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const pillars = Object.entries(PILLARS) as [string, { name: string; color: string }][];
---

<BaseLayout
  title="Blog — Edgar Sierra"
  description="Artículos sobre análisis de datos, ingeniería GCP, estadística e IA aplicada a problemas reales de Guatemala y Centroamérica."
>
  <div class="blog-page">
    <header class="blog-header" data-reveal>
      <h1 class="blog-title">Blog</h1>
      <p class="blog-subtitle">
        Análisis de datos, ingeniería GCP, estadística e IA aplicada.
        Un artículo nuevo cada mes.
      </p>
    </header>

    <SearchBox />

    <div class="filter-bar" role="group" aria-label="Filtrar por pilar">
      <button class="filter-chip active" data-filter="all">Todos</button>
      {pillars.map(([key, { name, color }]) => (
        <button
          class="filter-chip"
          data-filter={key}
          style={`--chip-color: ${color}`}
        >
          {name}
        </button>
      ))}
    </div>

    {posts.length === 0 ? (
      <p class="empty-state">No hay artículos publicados todavía.</p>
    ) : (
      <div class="posts-grid" id="posts-grid">
        {posts.map((post, i) => (
          <div
            class="post-item"
            data-pillar={String(post.data.pillar)}
            data-reveal
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <Card post={post} />
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.post-item');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter ?? 'all';

      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      items.forEach(item => {
        const show = filter === 'all' || item.dataset.pillar === filter;
        item.style.display = show ? '' : 'none';
        // Re-trigger an entrance animation on the cards that remain visible.
        if (show && !reduce) {
          item.classList.add('is-visible');
          item.classList.remove('filter-in');
          void item.offsetWidth; // force reflow so the animation restarts
          item.classList.add('filter-in');
        }
      });
    });
  });
</script>

<style>
  .blog-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .blog-header {
    margin-bottom: var(--space-8);
    max-width: var(--reading);
  }

  .blog-title {
    font-family: var(--font-ui);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .blog-subtitle {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: var(--leading-body);
  }

  /* ── Filter bar ─────────────────────────── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .filter-chip {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 0.35em var(--space-3);
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    letter-spacing: 0.01em;
  }

  .filter-chip[data-filter="all"].active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .filter-chip[data-filter]:not([data-filter="all"]).active {
    border-color: var(--chip-color, var(--accent));
    color: var(--chip-color, var(--accent));
    background: transparent;
  }

  .filter-chip:hover:not(.active) {
    border-color: var(--ink-muted);
    color: var(--ink);
  }

  /* ── Posts grid ─────────────────────────── */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-4);
  }

  .post-item {
    display: flex;
    flex-direction: column;
  }

  .post-item > * {
    flex: 1;
  }

  /* Reanimación al cambiar de filtro */
  @media (prefers-reduced-motion: no-preference) {
    .post-item.filter-in {
      animation: es-fade-up 0.4s ease both;
    }
  }

  .empty-state {
    font-family: var(--font-ui);
    color: var(--ink-muted);
    font-size: var(--text-base);
    padding: var(--space-8) 0;
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
