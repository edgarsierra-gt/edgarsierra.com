---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIALS } from '../data/socials';

const apiBase =
  (import.meta.env.PUBLIC_API_URL as string | undefined) ??
  'https://api.edgarsierra.com';
---

<BaseLayout
  title="Contacto — Edgar Sierra"
  description="Contacto directo con Edgar Sierra. Proyectos, consultas o propuestas de charla."
>
  <div class="contacto-page">
    <header class="page-header" data-reveal>
      <h1 class="page-title">Contacto</h1>
      <p class="page-subtitle">
        ¿Proyecto, consulta técnica o propuesta de charla?
        Escribime directamente o usá el formulario.
      </p>
    </header>

    <div class="contacto-layout">

      <!-- ── Formulario ──────────────────────── -->
      <section class="form-section" data-reveal>
        <h2 class="form-title">Formulario</h2>

        <form class="contact-form" id="contact-form" data-api-base={apiBase} novalidate>

          <div class="field">
            <label for="nombre">Nombre</label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              autocomplete="name"
              placeholder="Tu nombre"
            />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="tu@email.com"
            />
          </div>

          <div class="field">
            <label for="mensaje">Mensaje</label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              rows="5"
              placeholder="¿En qué puedo ayudarte?"
            ></textarea>
          </div>

          <!-- Honeypot — invisible for humans, visible to bots -->
          <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
            <label for="website">Website</label>
            <input
              type="text"
              id="website"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="form-footer">
            <button type="submit" class="submit-btn" id="submit-btn">
              Enviar mensaje
            </button>
            <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
          </div>

        </form>
      </section>

      <!-- ── Contacto directo ────────────────── -->
      <aside class="direct-section" data-reveal style="--reveal-delay: 90ms">
        <h2 class="direct-title">Contacto directo</h2>

        <div class="contact-item">
          <span class="contact-label">Email</span>
          <a href={`mailto:${SOCIALS.email}`} class="contact-value">
            {SOCIALS.email}
          </a>
        </div>

        <div class="social-links">
          <h3 class="social-title">Redes</h3>
          <nav aria-label="Redes sociales">
            <a href={SOCIALS.github} rel="noopener noreferrer" class="social-link">
              GitHub
            </a>
            <a href={SOCIALS.linkedin} rel="noopener noreferrer" class="social-link">
              LinkedIn
            </a>
            <a href={SOCIALS.medium} rel="noopener noreferrer" class="social-link">
              Medium
            </a>
            <a href={SOCIALS.twitter} rel="noopener noreferrer" class="social-link">
              X
            </a>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status') as HTMLElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  if (form && statusEl && submitBtn) {
    const API_BASE: string =
      form.dataset.apiBase ?? 'https://api.edgarsierra.com';

    function setLoading(loading: boolean): void {
      submitBtn!.disabled = loading;
      submitBtn!.textContent = loading ? 'Enviando…' : 'Enviar mensaje';
    }

    function showStatus(type: 'success' | 'error' | '', message: string): void {
      statusEl!.className = type ? `form-status form-status--${type}` : 'form-status';
      statusEl!.textContent = message;
    }

    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      const nombre  = (form.elements.namedItem('nombre')  as HTMLInputElement).value.trim();
      const email   = (form.elements.namedItem('email')   as HTMLInputElement).value.trim();
      const mensaje = (form.elements.namedItem('mensaje') as HTMLTextAreaElement).value.trim();
      const website = (form.elements.namedItem('website') as HTMLInputElement)?.value ?? '';

      if (!nombre || !email || !mensaje) {
        showStatus('error', 'Por favor completá todos los campos.');
        return;
      }

      setLoading(true);
      showStatus('', '');

      try {
        const res = await fetch(`${API_BASE}/contact`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: nombre, email, message: mensaje, website }),
        });
        const json = await res.json().catch(() => ({})) as Record<string, unknown>;
        if (!res.ok) {
          throw new Error(
            typeof json.detail === 'string' ? json.detail : 'Error al enviar el mensaje.'
          );
        }
        showStatus(
          'success',
          typeof json.message === 'string' && json.message
            ? json.message
            : 'Mensaje recibido. Te respondo pronto.'
        );
        form.reset();
      } catch (err) {
        showStatus(
          'error',
          err instanceof Error ? err.message : 'Error al enviar. Intentá de nuevo.'
        );
      } finally {
        setLoading(false);
      }
    });
  }
</script>

<style>
  .contacto-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    max-width: var(--reading);
    margin-inline: auto;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-family: var(--font-ui);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: var(--leading-body);
  }

  /* ── Layout ──────────────────────────────── */
  .contacto-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-8);
    align-items: start;
  }

  /* ── Form ────────────────────────────────── */
  .form-title,
  .direct-title {
    font-family: var(--font-ui);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .field label {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
  }

  .field input,
  .field textarea {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    transition: border-color 0.15s;
    width: 100%;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 114, 178, 0.12);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--ink-muted);
  }

  .field textarea {
    resize: vertical;
    line-height: var(--leading-body);
  }

  /* ── Form footer (button + status) ──────── */
  .form-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .submit-btn {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 500;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius);
    border: 2px solid var(--accent);
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .submit-btn:hover:not(:disabled) {
    opacity: 0.85;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* ── Status messages ─────────────────────── */
  .form-status {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: 1.5;
    min-height: 1.5em;
    width: 100%;
  }

  .form-status--success {
    padding: var(--space-2) var(--space-3);
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius);
  }

  .form-status--error {
    padding: var(--space-2) var(--space-3);
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
    border-radius: var(--radius);
  }

  /* ── Direct section ──────────────────────── */
  .direct-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .contact-value {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--accent);
    text-decoration: none;
  }

  .contact-value:hover { text-decoration: underline; }

  .social-title {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .social-links nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .social-link {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  .social-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .contacto-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
