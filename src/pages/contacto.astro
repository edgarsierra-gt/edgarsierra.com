---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto — Edgar Sierra"
  description="Contacto directo con Edgar Sierra. Proyectos, consultas o propuestas de charla."
>
  <div class="contacto-page">
    <header class="page-header">
      <h1 class="page-title">Contacto</h1>
      <p class="page-subtitle">
        ¿Proyecto, consulta técnica o propuesta de charla?
        Escribime directamente o usá el formulario.
      </p>
    </header>

    <div class="contacto-layout">

      <!-- ── Formulario ──────────────────────── -->
      <section class="form-section">
        <h2 class="form-title">Formulario</h2>

        {/* TODO: wire to POST /contact en Fase 2 */}
        <form class="contact-form" id="contact-form" novalidate>
          <div class="field">
            <label for="nombre">Nombre</label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              autocomplete="name"
              placeholder="Tu nombre"
            />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="tu@email.com"
            />
          </div>

          <div class="field">
            <label for="mensaje">Mensaje</label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              rows="5"
              placeholder="¿En qué puedo ayudarte?"
            ></textarea>
          </div>

          <button type="submit" class="submit-btn" disabled>
            Enviar mensaje
            <span class="btn-note">(disponible en breve)</span>
          </button>
        </form>
      </section>

      <!-- ── Contacto directo ────────────────── -->
      <aside class="direct-section">
        <h2 class="direct-title">Contacto directo</h2>

        <div class="contact-item">
          <span class="contact-label">Email</span>
          <a href="mailto:edgar@edgarsierra.com" class="contact-value">
            edgar@edgarsierra.com
          </a>
        </div>

        <div class="social-links">
          <h3 class="social-title">Redes</h3>
          <nav aria-label="Redes sociales">
            <a href="https://github.com/edgarsierra-gt" rel="noopener noreferrer" class="social-link">
              GitHub
            </a>
            <a href="#" rel="noopener noreferrer" class="social-link">
              LinkedIn
            </a>
            <a href="#" rel="noopener noreferrer" class="social-link">
              Medium
            </a>
            <a href="#" rel="noopener noreferrer" class="social-link">
              X
            </a>
          </nav>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .contacto-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    max-width: var(--reading);
    margin-inline: auto;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-family: var(--font-ui);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: var(--leading-body);
  }

  /* ── Layout ──────────────────────────────── */
  .contacto-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-8);
    align-items: start;
  }

  /* ── Form ────────────────────────────────── */
  .form-title,
  .direct-title {
    font-family: var(--font-ui);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .field label {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
  }

  .field input,
  .field textarea {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    transition: border-color 0.15s;
    width: 100%;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(0, 114, 178, 0.12);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--ink-muted);
  }

  .field textarea {
    resize: vertical;
    line-height: var(--leading-body);
  }

  .submit-btn {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 500;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    border: 2px solid var(--border);
    background: var(--surface);
    color: var(--ink-muted);
    cursor: not-allowed;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    opacity: 0.65;
    align-self: flex-start;
  }

  .btn-note {
    font-size: var(--text-xs);
    font-style: italic;
  }

  /* ── Direct section ──────────────────────── */
  .direct-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .contact-value {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--accent);
    text-decoration: none;
  }

  .contact-value:hover { text-decoration: underline; }

  .social-title {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .social-links nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .social-link {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }

  .social-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .contacto-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
